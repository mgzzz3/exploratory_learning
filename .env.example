ENVIRONMENT=development
DATABASE_URL=mysql+asyncmy://root:development-password@127.0.0.1:3306/ai_school_dev?charset=utf8mb4
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=["http://localhost:10086","http://127.0.0.1:10086","https://bkgame.cc","https://www.bkgame.cc"]

WX_APP_ID=
WX_APP_SECRET=
# 项目兼容 DEEPSEEK_API 和 DEEPSEEK_API_KEY；二选一即可。
DEEPSEEK_API=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_MAX_RETRIES=3
TAVILY_API_KEY=
QUESTION_GENERATION_MODE=grounded
# 同一总预算：默认检索截止 30s、研究截止 45s、总截止 85s。
# 缩短总预算时需同步调整预留，非法组合会拒绝启动。
RESEARCH_TOTAL_TIMEOUT_SECONDS=85
RESEARCH_GENERATION_RESERVE_SECONDS=40
RESEARCH_FINALIZATION_RESERVE_SECONDS=15
GROUNDING_VALIDATION_RESERVE_SECONDS=15
AD_UNIT_ID=

# true 会强制微信和 DeepSeek 都使用本地 mock。
USE_MOCK_SERVICES=false
